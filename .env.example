# ─── Credenciais da aplicação ────────────────────────────────────────────
# https://dashboard.pluggy.ai  →  menu "Applications"  →  criar aplicação
# As duas credenciais aparecem juntas depois que a aplicação é criada.
# São UUIDs. Nunca comite este arquivo nem use estes valores no app cliente.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ─── IDs dos items ───────────────────────────────────────────────────────
# ATENÇÃO: o UUID que aparece na URL do Meu Pluggy
# (meu.pluggy.ai/connections/<uuid>) NÃO é o itemId. Ele retorna 404.
#
# Conectar o banco no Meu Pluggy não basta — é preciso vincular a conexão
# à sua aplicação do Dashboard. Faça uma vez por banco:
#   1. dashboard.pluggy.ai → abra sua aplicação → "Ir para Demo"
#   2. escolha o conector "MeuPluggy"
#   3. faça login na sua conta Meu Pluggy e autorize o acesso
#   4. menu de três pontos da conexão → "Copiar Item ID"
#
# Múltiplos bancos: separe por vírgula, sem espaço.
PLUGGY_ITEM_IDS=

# ─── Banco de dados ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (modo "Transaction")
# Use a porta 6543 (pooler), não a 5432.
DATABASE_URL=

# ─── Seu identificador no app ────────────────────────────────────────────
# Qualquer uuid fixo. Gere uma vez e não mude mais:
#   node -e "console.log(crypto.randomUUID())"
KAIRO_USER_ID=

# ─── Segredo do cron ─────────────────────────────────────────────────────
# Protege a Edge Function `sync` (cron diário do Pluggy) de ser chamada por
# qualquer um. O mesmo valor vai em `supabase secrets set SYNC_SECRET=...`
# e no SQL do cron.
SYNC_SECRET=

# ─── Segredo do sync do app ──────────────────────────────────────────────
# Protege a Edge Function `sync-routine` (chamada pelo app mobile/desktop).
# Segredo SEPARADO do SYNC_SECRET acima de propósito: este valor também vai
# embutido no bundle do app (apps/mobile/.env, EXPO_PUBLIC_MOBILE_SYNC_SECRET),
# então é mais exposto — um vazamento aqui nunca deve alcançar o sync financeiro.
#   node -e "console.log(crypto.randomUUID())"
MOBILE_SYNC_SECRET=
